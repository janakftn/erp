    "/api/Worker/dobavljaci": {
      "post": {
        "tags": [
          "Worker"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Ime",
                  "Kontakt",
                  "Prezime"
                ],
                "type": "object",
                "properties": {
                  "Ime": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "Prezime": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "Kontakt": {
                    "maxLength": 100,
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Ime": {
                  "style": "form"
                },
                "Prezime": {
                  "style": "form"
                },
                "Kontakt": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuyProductDTO": {
        "type": "object",
        "properties": {
          "nacinPlacanja": {
            "$ref": "#/components/schemas/NacinPlacanja"
          },
          "stavkeProdaje": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductItemKupovineDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CardPaymentDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateProductDTO": {
        "required": [
          "boja",
          "brend",
          "cena",
          "ime",
          "kolicina",
          "slika"
        ],
        "type": "object",
        "properties": {
          "ime": {
            "minLength": 1,
            "type": "string"
          },
          "cena": {
            "type": "number",
            "format": "double"
          },
          "kolicina": {
            "type": "integer",
            "format": "int32"
          },
          "boja": {
            "minLength": 1,
            "type": "string"
          },
          "brend": {
            "minLength": 1,
            "type": "string"
          },
          "slika": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "required": [
          "email",
          "sifra"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "sifra": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NacinPlacanja": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "OrderDTO": {
        "type": "object",
        "properties": {
          "idDobavljaca": {
            "type": "integer",
            "format": "int32"
          },
          "stavkePorudzbine": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductItemPorudzbineDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductItemKupovineDTO": {
        "type": "object",
        "properties": {
          "idProizvoda": {
            "type": "integer",
            "format": "int32"
          },
          "kolicina": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProductItemPorudzbineDTO": {
        "type": "object",
        "properties": {
          "kolicina": {
            "type": "integer",
            "format": "int32"
          },
          "idProizvoda": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "RegisterDTO": {
        "required": [
          "adresa",
          "brojTelefona",
          "email",
          "ime",
          "korisnickoIme",
          "prezime",
          "sifra"
        ],
        "type": "object",
        "properties": {
          "korisnickoIme": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "[a-zA-Z0-9]+",
            "type": "string"
          },
          "sifra": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "ime": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "prezime": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "adresa": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "brojTelefona": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization header using the Bearer scheme. \r\n\r\n Enter 'Bearer' [space] and then your token in the text input below.\r\n\r\nExample: \"Bearer 1safsfsdfdfd\"",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}